# Copy to .env and fill in. Never commit a real secret.
AGENT_GAMES_HMAC_SECRET=
PORT=3000
# Optional: free key from kurier.xyz — enables on-chain confirmation of
# proofs (needed for scored rounds to count them as verified).
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
KURIER_POLL_BUDGET_MS=40000
